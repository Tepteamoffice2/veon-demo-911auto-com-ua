---
// Functional line icons, 1.5 px stroke (concept §5 «Зображення»): search, phone, viber, menu, close, check, minus, arrow.
type Name = "search" | "phone" | "viber" | "menu" | "close" | "check" | "minus" | "arrow";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "search" && (<><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 20 20" /></>)}
  {name === "phone" && (<path d="M5 4h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 4.9 4.9l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" />)}
  {name === "viber" && (<><path d="M12 3.5c-4.9 0-8 2.6-8 7.2 0 2.7 1 4.6 2.8 5.7V20l3-2.2c.7.1 1.4.2 2.2.2 4.9 0 8-2.6 8-7.3S16.9 3.5 12 3.5Z" /><path d="M9.6 8.2c.4 1.8 1.7 3.6 3.6 4.6l.9-.9 1.6.8c-.2.9-.9 1.4-1.7 1.3-2.7-.4-5.2-2.9-5.6-5.6-.1-.8.4-1.5 1.3-1.7l.8 1.6-.9.9" /></>)}
  {name === "menu" && (<path d="M4 7h16M4 12h16M4 17h16" />)}
  {name === "close" && (<path d="M6 6l12 12M18 6 6 18" />)}
  {name === "check" && (<path d="M5 12.5 10 17l9-10" />)}
  {name === "minus" && (<path d="M6 12h12" />)}
  {name === "arrow" && (<path d="M5 12h14M13 6l6 6-6 6" />)}
</svg>
