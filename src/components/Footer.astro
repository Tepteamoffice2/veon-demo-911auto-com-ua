---
import FutureLink from "./FutureLink.astro";
import { warehouses, phones, email, viber, legalName, futureNote } from "../data/client";

const pages = ["Каталог", "Оптовим покупцям", "Доставка та оплата", "Про нас", "Контакти", "Договір публічної оферти"];
const year = new Date().getFullYear();
---
<footer class="site-footer on-ink">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">911auto</p>
      <p class="site-footer__tag">Оригінальні запчастини Mitsubishi та інших японських марок</p>
      <a class="btn btn--secondary site-footer__top" href="#top">На початок сторінки</a>
    </div>
    {warehouses.map((w) => (
      <div class="site-footer__col">
        <p class="site-footer__title">{w.city}</p>
        <p>{w.region ? `${w.region}, ` : ""}{w.street}</p>
        <p>{w.hours}</p>
        <a class="text-link" href={`tel:${w.phone.tel}`}>{w.phone.display}</a>
      </div>
    ))}
    <div class="site-footer__col">
      <p class="site-footer__title">Зв’язок</p>
      <ul class="site-footer__list">
        {phones.support.map((p) => <li><a class="text-link" href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><a class="text-link" href={`mailto:${email}`}>{email}</a></li>
        <li><a class="text-link" href={viber.href}>Viber</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <ul class="site-footer__pages" aria-label="Сторінки сайту">
      {pages.map((p) => <li><FutureLink note={futureNote} class="future-link--start">{p}</FutureLink></li>)}
    </ul>
    <p class="site-footer__legal">© {year} {legalName}</p>
  </div>
</footer>
